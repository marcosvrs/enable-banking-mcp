{
  "mcpServers": {
    "enable-banking": {
      "command": "npx",
      "args": ["-y", "enable-banking-mcp@0.3.0"],
      "env": {
        "ENABLE_BANKING_CONTROL_PANEL_EMAIL": "${user_config.control_panel_email}",
        "ENABLE_BANKING_GDPR_EMAIL": "${user_config.gdpr_email}",
        "ENABLE_BANKING_ALLOW_RESTRICTED_PRODUCTION": "${user_config.allow_restricted_production}"
      }
    }
  }
}
